# Auto detect text files and perform LF normalization
* text=auto

# Keep config/script files stable as LF to avoid Windows checkout warnings.
.gitattributes text eol=lf
.gitignore text eol=lf
*.bak text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.json text eol=lf
*.json.disabled text eol=lf
*.json5 text eol=lf
*.jsonc text eol=lf
*.js text eol=lf
*.lewidget text eol=lf
*.local text eol=lf
*.log text eol=lf
*.mcfunction text eol=lf
*.mcmeta text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.fmdata text eol=lf

# Treat common packaged/binary assets as binary.
*.db binary
*.jar binary
*.nbt binary
*.ogg binary
*.png binary
